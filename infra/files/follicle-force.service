[Unit]
Description=FOLLICLE FORCE 3000™ Flask Application
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/follicle-force-3000
Environment=PATH=/home/ubuntu/follicle-force-env/bin
Environment=FLASK_APP=app.py
Environment=PORT=5000
ExecStart=/home/ubuntu/follicle-force-env/bin/python3 app.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=follicle-force

[Install]
WantedBy=multi-user.target
